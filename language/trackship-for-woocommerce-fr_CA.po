msgid "TrackShip MCP"
msgstr "TrackShip MCP"

#: includes/views/header2.php:71
msgid "TrackShip navigation"
msgstr "Navigation TrackShip"

#: includes/views/map-providers.php:33
msgid "TrackShip provider"
msgstr "Transporteur TrackShip"

