msgid " and "
msgstr "અને"

#. 1: security plugin name, 2: HTTP status.
#: includes/mcp/class-trackship-mcp-selftest.php:788
#, php-format
msgid "%1$s refused this request (%2$d) before it reached the plugin."
msgstr "%1$s એ આ વિનંતી (%2$d) પ્લગઇન સુધી પહોંચે તે પહેલાં જ નકારી કાઢી."

#. %s: the CDN's name, e.g. Cloudflare.
#: includes/mcp/class-trackship-mcp-selftest.php:463
#, php-format
msgid ""
"%1$s turned it away before it reached your site, so nothing here can undo it."
" In %1$s, look under Security for bot protection — Bot Fight Mode is the "
"usual one — and turn that off, or add a rule that skips it for this address."
msgstr ""
"%1$s એ તમારી સાઇટ પર પહોંચતા પહેલા તેને બંધ કરી દીધું, તેથી અહીં કંઈપણ તેને "
"પૂર્વવત્ કરી શકતું નથી. %1$s માં, બોટ સુરક્ષા માટે સુરક્ષા હેઠળ જુઓ — બોટ "
"ફાઇટ મોડ સામાન્ય છે — અને તેને બંધ કરો, અથવા આ સરનામાં માટે તેને છોડી દેતો "
"નિયમ ઉમેરો."

#. %d: how many connections were turned off.
#: includes/mcp/class-trackship-mcp-keys.php:239
msgid ""
"%d connection turned off. It will ask to sign in again next time it is used."
msgid_plural ""
"%d connections turned off. Each will ask to sign in again next time it is "
"used."
msgstr[0] ""
"%d કનેક્શન બંધ છે. આગલી વખતે તેનો ઉપયોગ કરવામાં આવશે ત્યારે તે ફરીથી સાઇન ઇન "
"કરવાનું કહેશે."
msgstr[1] ""
"%d કનેક્શન બંધ છે. દરેક કનેક્શન આગલી વખતે ઉપયોગમાં લેવા પર ફરીથી સાઇન ઇન "
"કરવાનું કહેશે."

#. %s: how long ago, e.g. "2 hours".
#. %s: a length of time, e.g. "2 hours".
#: includes/mcp/ui-helpers.php:634 includes/mcp/ui-helpers.php:711
#: includes/mcp/ui-helpers.php:1303
#, php-format
msgid "%s ago"
msgstr "%s પહેલા"

#. %s: security plugin name.
#: includes/mcp/class-trackship-mcp-selftest.php:489
#, php-format
msgid ""
"%s sent the refusal: open it and take the Python and Perl entries out of its "
"bad-bot or user agent list."
msgstr ""
"%s એ ઇનકાર મોકલ્યો: તેને ખોલો અને તેના બેડ-બોટ અથવા વપરાશકર્તા એજન્ટ "
"યાદીમાંથી Python અને Perl એન્ટ્રીઓ દૂર કરો."

#. 1: last characters of the key, 2: how long ago it was entered.
#: includes/mcp/ui-helpers.php:596
#, php-format
msgid ""
"A key ending %1$s was entered here %2$s ago, and your setup steps are below. "
"Enter another to replace it."
msgstr ""
"%2$s પહેલાં અહીં %1$s ના અંતમાં એક કી દાખલ કરવામાં આવી હતી, અને તમારા સેટઅપ "
"પગલાં નીચે આપેલ છે. તેને બદલવા માટે બીજી કી દાખલ કરો."

